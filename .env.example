# Strapi CMS Configuration
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_api_token_here

# Newsletter email via Brevo's SMTP relay (bogdev-infra README, section 6).
# Port 2525 because Hetzner blocks outbound 25 and 465. SMTP_PASS is the Brevo SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
NEWSLETTER_FROM="BogDev <no-reply@bogdev.com.co>"
SITE_URL=https://yourdomain.com

# Umami analytics (optional)
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
NUXT_UMAMI_URL=
